# Local / IDE
.Rproj.user
.Rhistory
.RData
.Ruserdata
*.html
*.Rproj

# Analysis outputs (writable at runtime)
# Track virgin seeds under data/reference/ and data/advice/
/data/**
!/data/.gitignore
!/data/reference/
!/data/reference/**
!/data/advice/
!/data/advice/advice.csv

# Knit products under Rmd/
/Rmd/html/
/Rmd/pdf/
/Rmd/docx/
/Rmd/figs/
/Rmd/cache/
/Rmd/*.docx
/Rmd/Final Report/
/Rmd/beamer/
/Rmd/00_overview.Rmd
/Rmd/05_figs.Rmd
/Rmd/06_mackerel_projections.Rmd
/Rmd/run_mackerel_projections.R
/Rmd/wip/

# LaTeX build products (sources under tex/*.tex stay tracked)
/tex/figs/
/tex/*.pdf
/tex/*.aux
/tex/*.log
/tex/*.out
/tex/*.toc
/tex/qa_report.txt
/tex/takeaways.csv
/tex/beamer/
/tex/beamer

# Maintainer / local-only
/scripts/_local/
/scripts/*.log
/docs/
/data-raw/
/flr-contrib/
/man-src/
LICENSE.md
fsp100.pdf

# Optional caches
*.Rcheck/
*.pptx
Rmd/mackerel.txt
*.tex~*

# renv (keep renv.lock and renv/activate.R tracked)
renv/library/
renv/staging/
renv/local/
renv/cellar/
renv/lock/
renv/sandbox/
renv/python/
renv/settings.d/
renv/.gitignore
