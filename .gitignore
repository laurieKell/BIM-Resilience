# Local / IDE
.Rproj.user
.Rhistory
.RData
.Ruserdata
*.html

# Local analysis workspace (~hundreds of MB: SS3, SAM, OM, TAC caches).
# Layout is documented in data/README.md. Package ships starting FLStocks in
# inst/extdata/ instead.
/data/**
!/data/README.md
!/data/.gitignore

# Knit / LaTeX products (sources under report/ stay tracked)
/report/html/
/report/pdf/
/report/docx/
/report/figs/
/report/latex/figs/
/report/latex/*.pdf
/report/latex/*.aux
/report/latex/*.log
/report/latex/*.out
/report/latex/*.toc
/report/latex/qa_report.txt
/report/latex/takeaways.csv

# Beamer build artefacts (keep .tex / .png / .pdf of decks)
/report/beamer/*.aux
/report/beamer/*.log
/report/beamer/*.nav
/report/beamer/*.out
/report/beamer/*.snm
/report/beamer/*.toc
/report/beamer/*.synctex.gz
/report/beamer/*~
/report/beamer/backup/

# Local Word review copies (not the runnable pipeline)
/report/Final Report/
/report/*.docx
fsp100.pdf

# Optional local caches
*.Rcheck/

*.pptx
report/mackerel.txt
report/latex/beamer/
# renv (keep renv.lock and renv/activate.R tracked)
renv/library/
renv/staging/
renv/local/
renv/cellar/
renv/lock/
renv/sandbox/
renv/python/
renv/settings.d/
renv/.gitignore
